# 文案转国漫视频剪映草稿生成器
# 复制为 .env 后填写。绝不要提交 .env 或泄露其中的密钥。
#
# 解析规则：
#   - 行尾可以写 ` # 注释`（井号前需有空格），会被去掉。
#   - 值里本身要包含 ` #` 时，请用引号把整个值括起来。
#   - 系统环境变量优先级高于本文件。`--check-config` 会打印每项的实际来源。

# ===== 火山方舟 Agent Plan：分镜规划与生图 =====
# 在方舟 Agent Plan 的“使用配置”中创建专属 API Key；文本、图片和语音共用这一把 Key。
ARK_API_KEY=
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/plan/v3
ARK_TEXT_MODEL=deepseek-v4-flash

ARK_IMAGE_URL=https://ark.cn-beijing.volces.com/api/plan/v3/images/generations
ARK_IMAGE_MODEL=doubao-seedream-5.0-lite
# 16:9 2K，横屏 1920x1080 草稿下还留有 1.33 倍裁切余量，够运镜和推近用。
ARK_IMAGE_SIZE=2560x1440
ARK_IMAGE_RESPONSE_FORMAT=url
ARK_IMAGE_OUTPUT_FORMAT=png
# 固定随机种子，画风更稳、断点重跑结果可复现。留空则每次随机。
ARK_IMAGE_SEED=
# 单张图片的价格（元），仅用于终端预估。留空则只显示张数。以控制台实际价格为准。
ARK_IMAGE_CNY_PER_IMAGE=
# 静态生图并发数。默认 3；若频繁出现 429，可降为 2；允许 1-8。
IMAGE_CONCURRENCY=3

# ===== 分镜密度 =====
# 每个镜头大致承载的中文字符数。中文 TTS 约 4-5 字/秒：
#   22 -> 每镜约 4.5-5.5 秒（偏慢，适合叙事）
#   14 -> 每镜约 3 秒
#   10 -> 每镜约 2 秒（快剪节奏，出图数量和成本同步上升）
# 下限为 8。想要快节奏但不想加钱，优先调小 MAX_SHOT_SECONDS（见下方“画面节奏”）。
SCENE_CHARACTERS_PER_IMAGE=22
SCENE_LENGTH_MODE=density

# ===== 火山方舟 Agent Plan：豆包语音合成 2.0 =====
# 该接口使用上方同一个 ARK_API_KEY，通过 X-Api-Key 鉴权。
ARK_TTS_URL=https://openspeech.bytedance.com/api/v3/plan/tts/unidirectional
ARK_TTS_MODEL=seed-tts-2.0
ARK_TTS_VOICE_TYPE=zh_male_liufei_uranus_bigtts
# 语速与响度范围均为 -50 到 100；0 表示模型默认值。
ARK_TTS_SPEECH_RATE=0
ARK_TTS_LOUDNESS_RATE=0
TTS_CONCURRENCY=3

# ===== 剪映与本地素材 =====
JIAN_YING_DRAFT_DIR=
OPENING_SOUND_PATH=assets/opening_dong.mp3
# 开场音效音量（线性增益，1.0 为原始音量）。
OPENING_SOUND_VOLUME=0.7
# 旁白整体延后的秒数，把开头留给音效和标题，避免“咚”的一声糊在第一句话上。
OPENING_LEAD_SECONDS=0.8
# 留空则不添加 BGM / 水印。
BGM_PATH=
# BGM 音量，线性增益而不是 dB。人声底下的背景音乐一般在 0.06-0.15 之间；
# 0.10 约等于 -20 dB。调到 0.3 以上旁白就会开始发糊。
BGM_VOLUME=0.10
WATERMARK_PATH=

# ===== 字幕 =====
# Y 坐标单位：以 1920 高为基准的像素，与画布高度无关（正数向上，负数向下）。
# 换算：transform_y = 该值 / 960，剪映的可见范围是 -1 到 1。
#   -700 -> -0.729，横屏 1080 画布上离底边约 146 px，即标准字幕位置
# 超出可见范围的值会被自动收到安全区内。用 --check-config 可以看到实际落点。
NARRATION_SUBTITLE_Y=-700
NARRATION_SUBTITLE_SIZE=8
# outline = 白字黑描边加投影（短视频标准做法，任何画面上都清晰）
# box     = 黑字白描边加半透明黑底（旧版样式）
SUBTITLE_STYLE=outline
# 字幕入场动画。填 none 关闭。常用：向上擦除 / 弹入 / 卡拉OK / 打字机_I / 冲屏位移
SUBTITLE_ANIMATION=向上擦除
SUBTITLE_ANIMATION_SECONDS=0.3

# ===== 标题 =====
# red / white / gold。固定取值而不是随机，同一账号连发多条才有视觉识别度。
TITLE_STYLE=red
# 正数向上：520 -> 上三分之一，避免压住画面主体和字幕。
TITLE_Y=520
TITLE_SIZE=14
TITLE_SECONDS=3
# 标题入场动画。填 none 关闭。
TITLE_ANIMATION=冲屏位移

# ===== 画面节奏与运镜 =====
# 镜头之间一律硬切，没有转场也没有入场动画，画面的运动完全交给下面的关键帧运镜。
#
# 单个镜头的最长秒数。超过就把这一句的画面切成两刀：先全景，再推近特写，
# 用的还是同一张图，所以画面节奏翻倍而出图成本不变。设为很大的值可关闭。
MAX_SHOT_SECONDS=3
# 关键帧运镜（推、拉、左右横移）。关掉就是完全静止的图片轮播。
KEN_BURNS=1

# ===== 全片统一画风 =====
# story     情感故事条漫：粗均匀墨线、平涂低饱和、柔和平光、腮红、背景简洁。
#           抖音情感/民间故事号最常见的画风，辨识度高，也最容易保持稳定。
# webtoon   韩式写实条漫：线更细、渲染更柔、色彩更克制，观感更“高级”一些。
# cinematic 高饱和深蓝 + 强对比电影光的国漫风（本项目的旧默认值）。
IMAGE_STYLE_PRESET=story
# 需要完全自定义时，在这里写整段提示词，会覆盖上面的预设。留空则使用预设。
IMAGE_STYLE_PROMPT=
