# 文案转国漫视频剪映草稿生成器
# 复制为 .env 后填写。绝不要提交 .env 或泄露其中的密钥。
#
# 解析规则：
#   - 行尾可以写 ` # 注释`（井号前需有空格），会被去掉。
#   - 值里本身要包含 ` #` 时，请用引号把整个值括起来。
#   - 系统环境变量优先级高于本文件。`--check-config` 会打印每项的实际来源。

# ===== 火山方舟 Agent Plan：分镜规划与生图 =====
# 在方舟 Agent Plan 的“使用配置”中创建专属 API Key；文本、图片和语音共用这一把 Key。
ARK_API_KEY=
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/plan/v3
ARK_TEXT_MODEL=deepseek-v4-flash

ARK_IMAGE_URL=https://ark.cn-beijing.volces.com/api/plan/v3/images/generations
ARK_IMAGE_MODEL=doubao-seedream-5.0-lite
# 16:9 2K，横屏 1920x1080 草稿下还留有 1.33 倍裁切余量，够运镜和推近用。
ARK_IMAGE_SIZE=2560x1440
ARK_IMAGE_RESPONSE_FORMAT=url
ARK_IMAGE_OUTPUT_FORMAT=png
# 固定随机种子，画风更稳、断点重跑结果可复现。留空则每次随机。
ARK_IMAGE_SEED=
# 单张图片的价格（元），仅用于终端预估。留空则只显示张数。以控制台实际价格为准。
ARK_IMAGE_CNY_PER_IMAGE=
# 静态生图并发数。默认 3；若频繁出现 429，可降为 2；允许 1-8。
IMAGE_CONCURRENCY=3

# ===== 分镜密度 =====
# 每个镜头大致承载的中文字符数。中文 TTS 约 4-5 字/秒：
#   22 -> 每镜约 4.5-5.5 秒（偏慢，适合叙事）
#   14 -> 每镜约 3 秒
#   10 -> 每镜约 2 秒（快剪节奏，出图数量和成本同步上升）
# 下限为 8。一张图对应一个完整镜头，所以这里就是唯一控制画面节奏的参数。
SCENE_CHARACTERS_PER_IMAGE=22
SCENE_LENGTH_MODE=density

# ===== 火山方舟 Agent Plan：豆包语音合成 2.0 =====
# 该接口使用上方同一个 ARK_API_KEY，通过 X-Api-Key 鉴权。
ARK_TTS_URL=https://openspeech.bytedance.com/api/v3/plan/tts/unidirectional
ARK_TTS_MODEL=seed-tts-2.0
ARK_TTS_VOICE_TYPE=zh_male_liufei_uranus_bigtts
# 语速与响度范围均为 -50 到 100；0 表示模型默认值。
ARK_TTS_SPEECH_RATE=0
ARK_TTS_LOUDNESS_RATE=0
TTS_CONCURRENCY=3

# ===== 剪映与本地素材 =====
JIAN_YING_DRAFT_DIR=
# 留空或文件不存在时会自动合成一个开场音效，不必自己找素材。
# 但如果这里明确填了路径而文件不存在，会直接报错——那是打错字，不是没素材。
OPENING_SOUND_PATH=assets/opening_dong.mp3
# 开场音效音量（线性增益，1.0 为原始音量，也就是不改音量）。
OPENING_SOUND_VOLUME=1.0
# 旁白整体延后的秒数，把开头留给音效和标题，避免“咚”的一声糊在第一句话上。
# 这是下限：开场标题配音时会自动加长到刚好念得完，念不完就会被正文压过去。
OPENING_LEAD_SECONDS=0.8
# 开场标题是否也配音。默认开启：标题原本只画在画面上，从来没被念出来，
# 而 --title 给的标题正文里根本没有，于是整条视频开头是一句无声的大字。
SPEAK_TITLE=1
# 标题配音相对开头的延迟。开场音效的冲击在头 0.25 秒，0.5 秒时已经衰减 10 dB，
# 所以 0.45 秒开口是念在尾音上，而不是压在那一声“咚”上面。
TITLE_LEAD_SECONDS=0.45
# 留空则不添加 BGM / 水印。
BGM_PATH=
# BGM 音量，线性增益而不是 dB。人声底下的背景音乐一般在 0.06-0.15 之间；
# 0.10 约等于 -20 dB。调到 0.3 以上旁白就会开始发糊。
BGM_VOLUME=0.10
# 没有人声的空档（段落气口、结尾留白）里 BGM 抬到多少。抬起来片子才会有呼吸感；
# 设成和 BGM_VOLUME 一样就是全程恒定音量。
BGM_LIFT_VOLUME=0.20
# 压下去/抬起来各花多长时间。空档短于这个值的两倍就不抬，免得每句之间都在“喘”。
BGM_RAMP_SECONDS=0.25
WATERMARK_PATH=

# ===== 呼吸与收尾 =====
# 分镜模型会标出哪一句是段落结尾，那一句之后插入这么长的气口（只剩 BGM）。
# 没有气口的话所有句子会一句顶一句往前冲，是“AI 味”最明显的来源之一。
# 画面会撑过气口，不会黑屏。设为 0 关闭。
PARAGRAPH_PAUSE_SECONDS=0.5
# 最后一句念完之后，画面再停多久。别让片子在最后一个字上戛然而止，
# 尤其是结尾有“欢迎评论”这类 CTA 的时候。
ENDING_HOLD_SECONDS=1.8

# ===== 统一调色 =====
# 每张图是独立生成的，色温和明度会一张张漂；几十个硬切连起来看就是闪。
# 在最上层铺一条滤镜轨，用很低的强度把它们拉到同一个调子里。
#
# 留空 = 跟随画风。九个画风各自带一个配套滤镜（深蓝白描配「深蓝电影感」，
# 黑白电影配「高清黑白」，等等），换画风时滤镜会跟着换，不用手动改。
# 这里一旦填了值，就固定用它，画风不再影响。填 none 关闭调色。
COLOR_GRADE=
# 强度 0-100。目的是统一而不是上色，一般别超过 20。
COLOR_GRADE_INTENSITY=12

# ===== 字幕 =====
# 下面这几个数是从参考视频（1920x1080）上量出来的，不是拍脑袋定的：
# 字幕字号约 66 px，整块中心在画面 86% 高处，压在一块半透明深色底板上。
#
# Y 坐标单位：以 1920 高为基准的像素，与画布高度无关（正数向上，负数向下）。
# 换算：transform_y = 该值 / 960，剪映的可见范围是 -1 到 1。
#   -700 -> -0.729，横屏 1080 画布上离底边约 146 px，即参考视频里的位置
# 超出可见范围的值会被自动收到安全区内。用 --check-config 可以看到实际落点。
NARRATION_SUBTITLE_Y=-700
# 6.8 x SUBTITLE_EM_PX ≈ 66 px，与参考视频一致。旧版的 8 约合 78 px，明显更重。
NARRATION_SUBTITLE_SIZE=6.8
# 字幕字体。参考视频用的是中等字重的黑体，不是特黑 —— 底板和描边已经负责了
# 可读性，这个字号上用特黑会把字腔糊住。任何剪映自带字体名都可以填。
SUBTITLE_FONT=SourceHanSansCN_Medium
# plate   = 白字 + 细描边 + 半透明深色底板（参考视频的做法，默认）
# outline = 白字黑描边加投影，不带底板；画面偏亮时更干净
# box     = 黑字白描边加半透明黑底（旧版样式）
SUBTITLE_STYLE=plate
# 描边宽度，剪映上限是 40。plate 模式下底板已经把字和画面分开了，
# 描边只需要收边，16 左右就够；换成 outline 时再往上加到 24-28。
SUBTITLE_BORDER_WIDTH=16
# 中文字幕加一点字间距会明显更像“设计过的”。
SUBTITLE_LETTER_SPACING=2
# 每行最大宽度占屏幕比例。默认 0.88 而不是库里的 0.82，
# 让 22 字左右的句子尽量能排进一行 —— 一行和两行的字幕基线不在同一高度，
# 行数来回变会让字幕块上下跳。
SUBTITLE_MAX_LINE_WIDTH=0.88
# 剪映不暴露文字度量，所以字号只能估算：一个中文字按「字号 x 这个值」个像素宽算。
# 上面所有由像素反推出来的字号都用了它，标题的分行位置也用它算。
# 如果整体字都偏大或偏小，就调这一个数。
SUBTITLE_EM_PX=9.8
# 字幕入场动画。填 none 关闭。常用：向上擦除 / 弹入 / 卡拉OK / 打字机_I / 冲屏位移
SUBTITLE_ANIMATION=向上擦除
SUBTITLE_ANIMATION_SECONDS=0.3

# ===== 标题 =====
# 标题按参考视频的做法排：整块居中，两到三行，每行一个文字图层，
# 第一行用主色、后面几行用强调色（参考视频是暖白转正红）。
# 行的断点由程序自己挑，不交给剪映的自动换行 —— 断在哪里决定了整个开场
# 的样子，而自动换行只看宽度。想手动指定就在 --title 里直接写换行符。
#
# 留空 = 跟随画风。九个画风各自带一套配色（深蓝白描配 crimson，
# 黑白电影配 white，复古套印配 poster，等等）。
# 可选：crimson / paper / ink / white / gold / poster / electric / marker
TITLE_STYLE=
# 标题字体。参考视频用的是粗黑标题体这一类；换成任何剪映自带字体都行。
TITLE_FONT=优设标题黑
# 0 = 画面正中，参考视频就放在这里 —— 标题在的这两秒多，它就是画面本身。
# 想让它靠上，填正数（+300 约在上三分之一）。
TITLE_Y=0
# 19.5 x SUBTITLE_EM_PX ≈ 191 px，与参考视频一致（约占画面高度的 18%）。
TITLE_SIZE=19.5
TITLE_BORDER_WIDTH=22
# 每行最大宽度占屏幕比例，决定一行能放几个字（默认 19.5 字号下是 8 个）。
# 超过三行放不下时，程序会自动缩小字号，而不是让剪映再折一行。
TITLE_MAX_LINE_WIDTH=0.86
TITLE_SECONDS=2.4
# 标题入场 / 出场动画。填 none 关闭。参考视频是缩进来、放大出去。
TITLE_ANIMATION=缩小
TITLE_OUTRO=放大

# ===== 运镜 =====
# 一张图对应一个完整镜头，中途不会被切开；镜头之间一律硬切，没有转场也没有
# 入场动画。画面的运动完全交给下面的关键帧运镜。
#
# 关键帧运镜（推、拉、横移，五种轮换）。关掉就是完全静止的图片轮播。
KEN_BURNS=1
# 运镜速度，单位是「每秒走过画面的比例」，不是总幅度。
# 镜头的实际运动量 = 速度 x 时长，所以长短镜头的观感速度是一致的；
# 单个镜头最多走 22%，再长也不会推爆。0.035 约等于每秒 3.5%，比较克制；
# 想更明显调到 0.05，想几乎静止调到 0.015。
KEN_BURNS_RATE=0.035

# ===== 全片统一画风 =====
# 画风预设集中在 styles.json（仓库根目录，可换成任何 JSON 文件，见 IMAGE_STYLES_FILE）。
# 第一次运行会按内置默认自动生成它，之后改画风直接编辑那个文件即可，不用动代码。
#
# 共 9 个内置画风。每个画风不只是一段提示词，还带着三样必须跟它一起变的东西：
# 分镜导演拿到的“这是什么画”、配套滤镜、以及标题配色。
#
# midnight  深蓝白描（默认）：深蓝底 + 纯白线描，排线做明暗，全片只给一两样
#           东西上一点饱和色。参考视频用的就是这一套，也是最容易保持稳定的 ——
#           所有画面都是同一根线画出来的，隔几小时生成的图也能剪在一起。
# manhua    国漫条漫：细墨线、平涂、柔和日光、低饱和暖色。脸会演戏，
#           情绪和对话类文案用它最稳。
# ink       水墨留白：焦墨湿笔、宣纸纤维、大片留白，只有一枚朱红。
#           文案本身节奏慢的时候最好看。
# papercut  剪纸拼贴：分层剪纸 + 真实投影，五种纸色，没有线也没有渲染，
#           全靠形状和影子，很难做丑。
# riso      复古套印：荧光橙 + 深青双色套印，粗网点、故意错位、纸面颗粒。
#           很吵、很复古，海报感强。
# gouache   水粉绘本：不透明水粉、看得见笔触、暖旧色，午后长影。全套里最柔软的一个。
# noir      黑白电影：纯黑白实拍，单侧硬光、百叶窗影、雨和烟，银盐颗粒。
# neon      霓虹夜城：雨后夜城实拍，品红与青的霓虹、湿地面反射、大光斑。
#           和 noir 正好相反 —— 颜色就是主角。
# notebook  手绘笔记：米白纸上的黑色马克笔线稿，一道黄色荧光笔 + 少量红笔批注。
#           midnight 的“亮面”版本，知识科普类文案很合适。
IMAGE_STYLE_PRESET=midnight
# 指向画风 JSON 文件（相对路径基于本仓库根目录）。留空 = 仓库根目录的 styles.json。
IMAGE_STYLES_FILE=
# 需要完全自定义时，在这里写整段提示词，会覆盖上面预设的 prompt 字段
# （medium / avoid / grade / title 仍然沿用该预设）。留空则使用预设。
IMAGE_STYLE_PROMPT=
