# 文案转国漫视频剪映草稿生成器
# 复制为 .env 后填写。绝不要提交 .env 或泄露其中的密钥。
#
# 解析规则：
#   - 行尾可以写 ` # 注释`（井号前需有空格），会被去掉。
#   - 值里本身要包含 ` #` 时，请用引号把整个值括起来。
#   - 系统环境变量优先级高于本文件。`--check-config` 会打印每项的实际来源。

# ===== 火山方舟 Agent Plan：分镜规划与生图 =====
# 在方舟 Agent Plan 的“使用配置”中创建专属 API Key；文本、图片和语音共用这一把 Key。
ARK_API_KEY=
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/plan/v3
ARK_TEXT_MODEL=deepseek-v4-flash

ARK_IMAGE_URL=https://ark.cn-beijing.volces.com/api/plan/v3/images/generations
ARK_IMAGE_MODEL=doubao-seedream-5.0-lite
# 16:9 2K，横屏 1920x1080 草稿下还留有 1.33 倍裁切余量，够运镜和推近用。
ARK_IMAGE_SIZE=2560x1440
ARK_IMAGE_RESPONSE_FORMAT=url
ARK_IMAGE_OUTPUT_FORMAT=png
# 固定随机种子，画风更稳、断点重跑结果可复现。留空则每次随机。
ARK_IMAGE_SEED=
# 单张图片的价格（元），仅用于终端预估。留空则只显示张数。以控制台实际价格为准。
ARK_IMAGE_CNY_PER_IMAGE=
# 静态生图并发数。默认 3；若频繁出现 429，可降为 2；允许 1-8。
IMAGE_CONCURRENCY=3

# ===== 分镜密度 =====
# 每个镜头大致承载的中文字符数。中文 TTS 约 4-5 字/秒：
#   22 -> 每镜约 4.5-5.5 秒（偏慢，适合叙事）
#   14 -> 每镜约 3 秒
#   10 -> 每镜约 2 秒（快剪节奏，出图数量和成本同步上升）
# 下限为 8。一张图对应一个完整镜头，所以这里就是唯一控制画面节奏的参数。
SCENE_CHARACTERS_PER_IMAGE=22
SCENE_LENGTH_MODE=density

# ===== 火山方舟 Agent Plan：豆包语音合成 2.0 =====
# 该接口使用上方同一个 ARK_API_KEY，通过 X-Api-Key 鉴权。
ARK_TTS_URL=https://openspeech.bytedance.com/api/v3/plan/tts/unidirectional
ARK_TTS_MODEL=seed-tts-2.0
ARK_TTS_VOICE_TYPE=zh_male_liufei_uranus_bigtts
# 语速与响度范围均为 -50 到 100；0 表示模型默认值。
ARK_TTS_SPEECH_RATE=0
ARK_TTS_LOUDNESS_RATE=0
TTS_CONCURRENCY=3

# ===== 剪映与本地素材 =====
JIAN_YING_DRAFT_DIR=
OPENING_SOUND_PATH=assets/opening_dong.mp3
# 开场音效音量（线性增益，1.0 为原始音量）。
OPENING_SOUND_VOLUME=0.7
# 旁白整体延后的秒数，把开头留给音效和标题，避免“咚”的一声糊在第一句话上。
OPENING_LEAD_SECONDS=0.8
# 留空则不添加 BGM / 水印。
BGM_PATH=
# BGM 音量，线性增益而不是 dB。人声底下的背景音乐一般在 0.06-0.15 之间；
# 0.10 约等于 -20 dB。调到 0.3 以上旁白就会开始发糊。
BGM_VOLUME=0.10
# 没有人声的空档（段落气口、结尾留白）里 BGM 抬到多少。抬起来片子才会有呼吸感；
# 设成和 BGM_VOLUME 一样就是全程恒定音量。
BGM_LIFT_VOLUME=0.20
# 压下去/抬起来各花多长时间。空档短于这个值的两倍就不抬，免得每句之间都在“喘”。
BGM_RAMP_SECONDS=0.25
WATERMARK_PATH=

# ===== 呼吸与收尾 =====
# 分镜模型会标出哪一句是段落结尾，那一句之后插入这么长的气口（只剩 BGM）。
# 没有气口的话所有句子会一句顶一句往前冲，是“AI 味”最明显的来源之一。
# 画面会撑过气口，不会黑屏。设为 0 关闭。
PARAGRAPH_PAUSE_SECONDS=0.5
# 最后一句念完之后，画面再停多久。别让片子在最后一个字上戛然而止，
# 尤其是结尾有“欢迎评论”这类 CTA 的时候。
ENDING_HOLD_SECONDS=1.8

# ===== 统一调色 =====
# 每张图是独立生成的，色温和明度会一张张漂；几十个硬切连起来看就是闪。
# 在最上层铺一条滤镜轨，用很低的强度把它们拉到同一个调子里。
# 灰调中性 = 中性灰调，只统一不上色，适合大多数情况。
# 其他可选：侘寂灰 / 米棕 / 牛皮纸 / 怀旧 / 古早韩系 / 灰调日常。填 none 关闭。
COLOR_GRADE=灰调中性
# 强度 0-100。目的是统一而不是上色，一般别超过 20。
COLOR_GRADE_INTENSITY=12

# ===== 字幕 =====
# Y 坐标单位：以 1920 高为基准的像素，与画布高度无关（正数向上，负数向下）。
# 换算：transform_y = 该值 / 960，剪映的可见范围是 -1 到 1。
#   -700 -> -0.729，横屏 1080 画布上离底边约 146 px，即标准字幕位置
# 超出可见范围的值会被自动收到安全区内。用 --check-config 可以看到实际落点。
NARRATION_SUBTITLE_Y=-700
NARRATION_SUBTITLE_SIZE=8
# outline = 白字黑描边加投影（短视频标准做法，任何画面上都清晰）
# box     = 黑字白描边加半透明黑底（旧版样式）
SUBTITLE_STYLE=outline
# 描边宽度，剪映上限是 40。40 压在低饱和浅色画面上会显脏，配合已有的投影
# 24 左右更干净；画面偏暗或偏花时再往上加。
SUBTITLE_BORDER_WIDTH=24
# 中文字幕加一点字间距会明显更像“设计过的”。
SUBTITLE_LETTER_SPACING=2
# 每行最大宽度占屏幕比例。默认 0.88 而不是库里的 0.82，
# 让 22 字左右的句子尽量能排进一行 —— 一行和两行的字幕基线不在同一高度，
# 行数来回变会让字幕块上下跳。
SUBTITLE_MAX_LINE_WIDTH=0.88
# 剪映不暴露文字度量，所以换行只能估算：一个中文字按「字号 x 这个值」个像素宽算。
# 它只用来做换行补偿 —— 剪映的文本块以中心定位，两行的字幕会向上下同时扩展，
# 底行就比一行时低，来回切换会让字幕上下跳。程序按估算的行数把整块往上抬，
# 让底行基线保持不动。如果字幕换行时仍然会飘，就调这一个数。
SUBTITLE_EM_PX=9.8
# 字幕入场动画。填 none 关闭。常用：向上擦除 / 弹入 / 卡拉OK / 打字机_I / 冲屏位移
SUBTITLE_ANIMATION=向上擦除
SUBTITLE_ANIMATION_SECONDS=0.3

# ===== 标题 =====
# paper / red / white / gold。固定取值而不是随机，同一账号连发多条才有视觉识别度。
# paper = 暖米白配深褐描边，取自 story 画风的色板，不会跟低饱和画面打架。
# red   = 纯红配白边，冲击力强，但压在低饱和画风上会很跳。
TITLE_STYLE=paper
# 正数向上：520 -> 上三分之一，避免压住画面主体和字幕。
TITLE_Y=520
TITLE_SIZE=14
TITLE_BORDER_WIDTH=28
TITLE_SECONDS=3
# 标题入场动画。填 none 关闭。
TITLE_ANIMATION=冲屏位移

# ===== 运镜 =====
# 一张图对应一个完整镜头，中途不会被切开；镜头之间一律硬切，没有转场也没有
# 入场动画。画面的运动完全交给下面的关键帧运镜。
#
# 关键帧运镜（推、拉、横移，五种轮换）。关掉就是完全静止的图片轮播。
KEN_BURNS=1
# 运镜速度，单位是「每秒走过画面的比例」，不是总幅度。
# 镜头的实际运动量 = 速度 x 时长，所以长短镜头的观感速度是一致的；
# 单个镜头最多走 22%，再长也不会推爆。0.035 约等于每秒 3.5%，比较克制；
# 想更明显调到 0.05，想几乎静止调到 0.015。
KEN_BURNS_RATE=0.035

# ===== 全片统一画风 =====
# 画风预设集中在 styles.json（仓库根目录，可换成任何 JSON 文件，见 IMAGE_STYLES_FILE）。
# 第一次运行会按内置默认自动生成它，之后改画风直接编辑那个文件即可，不用动代码。
# 共 7 个内置预设：
# story      情感故事条漫：粗均匀墨线、平涂低饱和、柔和平光、腮红、背景简洁。
#            抖音情感/民间故事号最常见的画风，辨识度高，也最容易保持稳定。
# webtoon    韩式写实条漫：线更细、渲染更柔、色彩更克制，观感更“高级”一些。
# cinematic  高饱和深蓝 + 强对比电影光的国漫风（本项目的旧默认值）。
# ghibli     吉卜力手绘动画：云海浮岛、水彩质感、暖金落光，梦幻绘本感。
# noir       暗调电影实拍感：霓虹红蓝、烟雾雨夜、高对比明暗，孤独都市氛围。
# fantasy    魔幻现实夜景：巨榕灯影、萤火浮光、深蓝夜色，民间志怪气质。
# documentary 纪实摄影：晨雾渔港、自然光、35mm 胶片颗粒，人文纪实感。
IMAGE_STYLE_PRESET=story
# 指向画风 JSON 文件（相对路径基于本仓库根目录）。留空 = 仓库根目录的 styles.json。
IMAGE_STYLES_FILE=
# 需要完全自定义时，在这里写整段提示词，会覆盖上面的预设。留空则使用预设。
IMAGE_STYLE_PROMPT=
