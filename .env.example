# 文案转动态字幕剪映草稿生成器
# 复制为 .env 后填写。绝不要提交 .env 或泄露其中的密钥。

# ===== 火山方舟 Agent Plan：分镜规划与首帧生图 =====
# 在方舟 Agent Plan 的“使用配置”中创建专属 API Key；文本、图片和语音共用这一把 Key。
ARK_API_KEY=
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/plan/v3
ARK_TEXT_MODEL=deepseek-v4-flash

ARK_IMAGE_URL=https://ark.cn-beijing.volces.com/api/plan/v3/images/generations
ARK_IMAGE_MODEL=doubao-seedream-5.0-lite
# Seedream 5.0 Lite 的 16:9 2K 尺寸，适合 1920x1080 剪映草稿。
ARK_IMAGE_SIZE=2560x1440
ARK_IMAGE_RESPONSE_FORMAT=url
ARK_IMAGE_OUTPUT_FORMAT=png
# 静态生图并发数。默认 3；若频繁出现 429，可降为 2；本程序允许 1-8。
IMAGE_CONCURRENCY=3
# 默认 22：让每段旁白通常接近 2-5 秒，便于与第 2-6 段动态视频同步。
SCENE_CHARACTERS_PER_IMAGE=22
SCENE_LENGTH_MODE=density

# ===== 火山方舟 Agent Plan：豆包语音合成 2.0 =====
# 该接口使用上方同一个 ARK_API_KEY，通过 X-Api-Key 鉴权。
ARK_TTS_URL=https://openspeech.bytedance.com/api/v3/plan/tts/unidirectional
ARK_TTS_MODEL=seed-tts-2.0
ARK_TTS_VOICE_TYPE=zh_male_liufei_uranus_bigtts
# 语速与响度范围均为 -50 到 100；0 表示模型默认值。
ARK_TTS_SPEECH_RATE=0
ARK_TTS_LOUDNESS_RATE=0
TTS_CONCURRENCY=3

# ===== 阿里云百炼图生视频 =====
# 在阿里云百炼（北京地域）创建 API Key。仅固定第 2、3、4、5、6 个分镜会调用图生视频。
DASHSCOPE_API_KEY=
# 当前采用可变时长的首帧图生视频模型；静音，避免和豆包旁白/BGM 重叠。
DASHSCOPE_I2V_MODEL=wan2.6-i2v-flash
DASHSCOPE_I2V_RESOLUTION=720P
# 轮询间隔与最长等待时间（秒）。视频任务通常需要数分钟。
DASHSCOPE_I2V_POLL_SECONDS=15
DASHSCOPE_I2V_TIMEOUT_SECONDS=900
# 仅用于终端预估；请以百炼控制台当前价格为准。
DASHSCOPE_I2V_CNY_PER_SECOND=0.155

# ===== 剪映和可选素材 =====
JIAN_YING_DRAFT_DIR=
# 留空则不添加 BGM / 水印。
BGM_PATH=
WATERMARK_PATH=
OPENING_SOUND_PATH=assets/opening_dong.mp3
# 所有旁白字幕的 Y 轴位置（剪映像素坐标）。
NARRATION_SUBTITLE_Y=-700
# 水印和开场音效均可替换为其他项目内相对路径或完整路径。

# ===== 全片统一漫画画风 =====
# 改等号后的内容即可。每张图只匹配对应字幕，不会强制添加图表或财经元素。
IMAGE_STYLE_PROMPT=Chinese social-realism manhua panel, mature narrative webcomic aesthetic, contemporary Chinese everyday setting, semi-realistic adult faces and believable human anatomy, strongly expressive facial emotions and dramatic but natural body language, bold crisp black ink outlines with varied line weight, flat color fills with hard-edged cel shading, subtle printed-comic texture on skin and clothing, saturated deep navy blue contrasted with muted warm earth tones, high-contrast cinematic lighting, simple clean interior or urban background with clear spatial depth, polished 2D illustration, not photorealistic, no 3D render, no watercolor, no soft pastel anime, no chibi, 16:9
